# Normalize line endings for the repo
* text=auto

# C/C++/Python force LF
*.c   text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.hpp text eol=lf
*.py  text eol=lf
*.md  text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# JSON/YAML
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# Binary
*.a   binary
*.so  binary
*.dll binary
*.lib binary
*.bc  binary
*.msi binary
